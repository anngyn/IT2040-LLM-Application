# Copy this file to .env when using a real API provider.
# The default config uses provider=mock and does not need secrets.

LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional local model path for provider=transformers.
LOCAL_MODEL_PATH=
