# --- GPT Provider ---
# GPT_PROVIDER=openai    → use OPENAI_API_KEY + OPENAI_API_URL directly
# GPT_PROVIDER=third-party → use LLAMA_API_KEY + LLAMA_BASE_URL for GPT calls too
GPT_PROVIDER=third-party

# OpenAI API (only if GPT_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Third-party provider (OpenAI-compatible, used for LLaMA + GPT if GPT_PROVIDER=third-party)
LLAMA_API_KEY=your-api-key
LLAMA_BASE_URL=https://your-provider.com/v1
LLAMA_MODEL=llama-3.3-70b-versatile

# GPT model names (for ref answer generation + judging)
GPT_MODEL=gx/gpt-5.5
GPT_JUDGE_MODEL=gx/gpt-5.5

# Local model path (only used when GPU is available)
LOCAL_MODEL_PATH=meta-llama/Llama-2-13b-chat-hf

# Force API mode (skip GPU detection on Windows)
# FORCE_API_MODE=1

# RAG settings (for fact-audit-rag.py)
WIKI_TOP_K=5
WIKI_MAX_CHARS=1500
WIKI_DELAY=1.0
